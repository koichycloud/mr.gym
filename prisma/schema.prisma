generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  username    String    @unique
  password    String
  role        String    @default("ADMIN")
  permissions Json      @default("[]")
  personalId  String?   @unique
  personal    Personal? @relation(fields: [personalId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  generacionesIASolicitadas      GeneracionIA[]       @relation("GeneracionIASolicitante")
  generacionesIAAprobadas        GeneracionIA[]       @relation("GeneracionIAAprobador")
  planesEntrenamientoAprobados   PlanEntrenamiento[]  @relation("PlanEntrenamientoAprobador")
  planesAlimentacionAprobados    PlanAlimentacion[]   @relation("PlanAlimentacionAprobador")
}


model Socio {
  id              String        @id @default(uuid())
  codigo          String        @unique
  nombres         String?
  apellidos       String?
  tipoDocumento   String        @default("DNI")
  numeroDocumento String        @unique
  fechaNacimiento DateTime
  sexo            String        @default("M") // M = Masculino, F = Femenino
  telefono        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  suscripciones    Suscripcion[]
  historialCodigos CodigoHistorial[]
  medidas          MedidaFisica[]
  asistencias      Asistencia[]
  pagos            Pago[]
  asignacionesEntrenador AsignacionEntrenador[]
  perfilesPlanificacion  PerfilPlanificacion[]
  generacionesIA         GeneracionIA[]
  planesEntrenamiento    PlanEntrenamiento[]
  planesAlimentacion     PlanAlimentacion[]
  periodosPersonalizados PeriodoEntrenamientoPersonalizado[]
  sesionesPersonalizadas SesionEntrenamientoPersonalizado[]
  fotoUrl          String? // URL de la foto del socio (Base64)
  estado           String        @default("ACTIVO") // ACTIVO o ANULADO
  motivoAnulacion  String? // Motivo por el cual se anula el registro

  @@index([nombres, apellidos]) // Optimize name search
  @@map("Socio")
}

model CodigoHistorial {
  id          String   @id @default(uuid())
  socioId     String
  codigo      String
  fechaCambio DateTime @default(now())
  socio       Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@index([codigo])
  @@index([socioId])
}

model Suscripcion {
  id          String   @id @default(uuid())
  socioId     String
  planId      String?
  fechaInicio DateTime @default(now())
  meses       Int
  fechaFin    DateTime
  estado      String   @default("ACTIVA")
  codigo      String?  // Code snapshot at the time of subscription
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  socio       Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  plan        Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([fechaFin, estado]) // Optimize expiration queries
  @@index([socioId])        // Optimize lookups by socio
}

model Plan {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  meses       Int
  precio      Float
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  suscripciones Suscripcion[]
  
  @@map("Plan")
}

model MedidaFisica {
  id              String   @id @default(uuid())
  socioId         String
  fecha           DateTime @default(now())
  peso            Float?
  altura          Float?
  porcentajeGrasa Float?
  porcentajeMusculo Float?
  cuello          Float?
  hombros         Float?
  pecho           Float?
  cintura         Float?
  vientreBajo     Float?
  cadera          Float?
  gluteos         Float?
  biceps          Float?
  antebrazos      Float?
  muslos          Float?
  cuadriceps      Float?
  pantorrillas    Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  socio           Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@index([socioId, fecha]) // Optimize chart data fetching
}

model Asistencia {
  id        String   @id @default(uuid())
  socioId   String
  fecha     DateTime @default(now())
  tipo      String   @default("ENTRADA") // ENTRADA o SALIDA
  socio     Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@index([socioId, fecha])
  @@index([fecha])
}

model Pago {
  id            String   @id @default(uuid())
  socioId       String?
  suscripcionId String?
  monto         Float
  metodoPago    String   @default("EFECTIVO") // EFECTIVO, TRANSFERENCIA, YAPE, PLIN
  concepto      String   @default("SUSCRIPCION") // SUSCRIPCION, PRODUCTO, OTRO
  descripcion   String?
  fecha         DateTime @default(now())
  createdAt     DateTime @default(now())
  socio         Socio?   @relation(fields: [socioId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([socioId])
}

model AuditLog {
  id        String   @id @default(uuid())
  usuario   String   // username de quien ejecutó la acción
  accion    String   // ej. LOGIN, CREAR_SOCIO, EDITAR_SOCIO, ELIMINAR_SOCIO, RENOVAR
  detalles  String?  // Descripción humana
  fecha     DateTime @default(now())

  @@index([usuario, fecha])
  @@index([accion])
}

// --- MÓDULO DE PERSONAL ---

model Personal {
  id              String   @id @default(uuid())
  codigo          String   @unique // Para el kiosco
  nombres         String
  apellidos       String
  tipoDocumento   String   @default("DNI") // DNI, CE, etc.
  dni             String   @unique // Usado para el número de documento
  telefono        String?
  rol             String   // Instructor, Recepcionista, etc.
  metodoPago      String   // POR_HORA, POR_DIA, SEMANAL, QUINCENAL, MENSUAL
  montoPago       Float    // Monto según el método
  horasObjetivo   Float    // Horas que debe cumplir en su ciclo (ej. 40 semanales, 80 quincenales)
  activo          Boolean  @default(true)
  fotoUrl         String?  // URL de la foto del personal (Base64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  horaEntradaManana String? // e.g. "08:00"
  horaEntradaTarde  String? // e.g. "14:00"

  user            User?

  asistencias     AsistenciaPersonal[]
  consumos        ConsumoPersonal[]
  adelantos       AdelantoPersonal[]
  pagos           PagoPersonal[]
  asignacionesEntrenador AsignacionEntrenador[]
  perfilesPlanificacion  PerfilPlanificacion[]
  generacionesIA         GeneracionIA[]
  planesEntrenamiento    PlanEntrenamiento[]
  planesAlimentacion     PlanAlimentacion[]
  periodosPersonalizadosEntrenador PeriodoEntrenamientoPersonalizado[]
  sesionesPersonalizadasEntrenador SesionEntrenamientoPersonalizado[]
  
  @@index([nombres, apellidos])
}

model AsistenciaPersonal {
  id                  String    @id @default(uuid())
  personalId          String
  fecha               DateTime  @default(now()) // Fecha de la jornada
  
  horaEntrada         DateTime?
  horaSalidaAlmuerzo  DateTime?
  horaEntradaAlmuerzo DateTime?
  horaSalida          DateTime?
  
  // Total de horas calculadas (Salida - Entrada) menos (EntradaAlmuerzo - SalidaAlmuerzo)
  horasTrabajadas     Float?    
  
  personal            Personal  @relation(fields: [personalId], references: [id], onDelete: Cascade)

  @@index([personalId, fecha])
}

model ProductoPersonal {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Float
  fotoUrl     String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  consumos    ConsumoPersonal[]
}

model ConsumoPersonal {
  id                 String   @id @default(uuid())
  personalId         String
  productoPersonalId String
  cantidad           Int      @default(1)
  montoTotal         Float    // cantidad * precio (al momento del consumo)
  fecha              DateTime @default(now())
  pagado             Boolean  @default(false)
  pagoId             String?  
  
  personal           Personal          @relation(fields: [personalId], references: [id], onDelete: Cascade)
  producto           ProductoPersonal  @relation(fields: [productoPersonalId], references: [id])
  pago               PagoPersonal?     @relation(fields: [pagoId], references: [id], onDelete: SetNull)
}

model AdelantoPersonal {
  id          String   @id @default(uuid())
  personalId  String
  monto       Float
  fecha       DateTime @default(now())
  motivo      String?
  estado      String   @default("PENDIENTE") // PENDIENTE, APROBADO, RECHAZADO
  pagado      Boolean  @default(false) 
  pagoId      String?  

  personal    Personal       @relation(fields: [personalId], references: [id], onDelete: Cascade)
  pago        PagoPersonal?  @relation(fields: [pagoId], references: [id], onDelete: SetNull)
}

model PagoPersonal {
  id            String   @id @default(uuid())
  personalId    String
  fechaInicio   DateTime 
  fechaFin      DateTime
  
  horasTrabajadas Float
  horasObjetivo   Float
  
  montoBase       Float    
  totalConsumos   Float  
  totalAdelantos  Float  
  montoFinal      Float    
  
  fechaPago       DateTime @default(now())
  
  personal      Personal           @relation(fields: [personalId], references: [id])
  consumos      ConsumoPersonal[]
  adelantos     AdelantoPersonal[]
}

// --- MÓDULO DE PLANIFICACIÓN PERSONALIZADA ---

model AsignacionEntrenador {
  id           String    @id @default(uuid())
  socioId      String
  entrenadorId String
  fechaInicio  DateTime  @default(now())
  fechaFin     DateTime?
  mesesPlan    Int
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  socio      Socio    @relation(fields: [socioId], references: [id], onDelete: Restrict)
  entrenador Personal @relation(fields: [entrenadorId], references: [id], onDelete: Restrict)

  perfilesPlanificacion  PerfilPlanificacion[]
  periodosPersonalizados PeriodoEntrenamientoPersonalizado[]

  @@index([socioId])
  @@index([entrenadorId])
  @@index([activo])
}

model PerfilPlanificacion {
  id                     String                @id @default(uuid())
  socioId                String
  entrenadorId           String
  asignacionId           String?
  version                Int                   @default(1)
  activo                 Boolean               @default(true)
  fechaInicio            DateTime              @default(now())
  fechaFin               DateTime?

  objetivoPrincipal      String
  objetivoSecundario     String?

  nivel                  String
  tiempoEntrenando       String?
  experienciaPrevia      String?
  capacidadCardiovascular String?
  capacidadFuerza         String?
  equipamientoDisponible  String?

  diasPorSemana          Int                   @default(3)
  diasPreferidos         Json?
  duracionMinutos        Int                   @default(60)
  horarioPreferido       String?

  tipoEntrenamiento      String?
  ejerciciosEvitados     String?

  lesionesReportadas     String?

  preferenciaAlimenticia String?
  alergiasDeclaradas     String?
  alimentosEvitados      String?
  numeroComidasDia       Int?
  consumoAguaLitros      Float?

  observaciones          String?
  motivoVersionado       String?

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  socio                  Socio                 @relation(fields: [socioId], references: [id], onDelete: Restrict)
  entrenador             Personal              @relation(fields: [entrenadorId], references: [id], onDelete: Restrict)
  asignacion             AsignacionEntrenador? @relation(fields: [asignacionId], references: [id], onDelete: Restrict)

  generacionesIA         GeneracionIA[]
  planesEntrenamiento    PlanEntrenamiento[]
  planesAlimentacion     PlanAlimentacion[]
  periodosPersonalizados PeriodoEntrenamientoPersonalizado[]

  @@index([socioId])
  @@index([entrenadorId])
  @@index([asignacionId])
  @@index([activo])
  @@index([fechaInicio])
}

// --- GENERACIONES IA Y PLANES PERSONALIZADOS ---

model GeneracionIA {
  id                     String               @id @default(uuid())
  socioId                String
  perfilPlanificacionId  String
  entrenadorId           String?
  usuarioId              String?
  numeroGeneracion       Int                  @default(1)
  modeloUtilizado        String
  versionSchema          String               @default("2.0")
  estado                 String               @default("GENERADO") // GENERADO, EN_REVISION, APROBADO, RECHAZADO, ARCHIVADO, ERROR
  requiresHumanReview    Boolean              @default(false)
  banderasAdvertencia    Json?
  promptTokens           Int?
  completionTokens       Int?
  tiempoGeneracionMs     Int?
  inputSnapshot          Json
  rawOutput              Json?
  fechaAprobacion        DateTime?
  aprobadoPorId          String?
  motivoRechazo          String?
  motivoRegeneracion     String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  socio                  Socio                @relation(fields: [socioId], references: [id], onDelete: Restrict)
  perfilPlanificacion    PerfilPlanificacion  @relation(fields: [perfilPlanificacionId], references: [id], onDelete: Restrict)
  entrenador             Personal?            @relation(fields: [entrenadorId], references: [id], onDelete: Restrict)
  usuario                User?                @relation("GeneracionIASolicitante", fields: [usuarioId], references: [id], onDelete: SetNull)
  aprobadoPor            User?                @relation("GeneracionIAAprobador", fields: [aprobadoPorId], references: [id], onDelete: SetNull)

  planesEntrenamiento    PlanEntrenamiento[]
  planesAlimentacion     PlanAlimentacion[]

  @@index([socioId])
  @@index([perfilPlanificacionId])
  @@index([entrenadorId])
  @@index([estado])
  @@index([createdAt])
}

model PlanEntrenamiento {
  id                     String               @id @default(uuid())
  socioId                String
  perfilPlanificacionId  String
  generacionIAId         String?
  entrenadorId           String?
  version                Int                  @default(1)
  activo                 Boolean              @default(true)
  estado                 String               @default("GENERADO") // GENERADO, EN_REVISION, APROBADO, MODIFICADO, ARCHIVADO
  titulo                 String
  descripcion            String?
  splitSugerido          String?
  frecuenciaSemanal      Int                  @default(3)
  nivelActual            Int                  @default(1)
  fechaInicio            DateTime             @default(now())
  fechaFin               DateTime?
  fechaAprobacion        DateTime?
  aprobadoPorId          String?
  contenido              Json
  observaciones          String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  socio                  Socio                @relation(fields: [socioId], references: [id], onDelete: Restrict)
  perfilPlanificacion    PerfilPlanificacion  @relation(fields: [perfilPlanificacionId], references: [id], onDelete: Restrict)
  generacionIA           GeneracionIA?        @relation(fields: [generacionIAId], references: [id], onDelete: Restrict)
  entrenador             Personal?            @relation(fields: [entrenadorId], references: [id], onDelete: Restrict)
  aprobadoPor            User?                @relation("PlanEntrenamientoAprobador", fields: [aprobadoPorId], references: [id], onDelete: SetNull)

  @@index([socioId])
  @@index([perfilPlanificacionId])
  @@index([generacionIAId])
  @@index([activo])
  @@index([estado])
}

model PlanAlimentacion {
  id                       String               @id @default(uuid())
  socioId                  String
  perfilPlanificacionId    String
  generacionIAId           String?
  entrenadorId             String?
  version                  Int                  @default(1)
  activo                   Boolean              @default(true)
  estado                   String               @default("GENERADO") // GENERADO, EN_REVISION, APROBADO, MODIFICADO, ARCHIVADO
  titulo                   String
  descripcion              String?
  lineamientosGenerales    Json?
  recomendacionHidratacion String?
  fechaInicio              DateTime             @default(now())
  fechaFin                 DateTime?
  fechaAprobacion          DateTime?
  aprobadoPorId            String?
  contenido                Json
  observaciones            String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  socio                    Socio                @relation(fields: [socioId], references: [id], onDelete: Restrict)
  perfilPlanificacion      PerfilPlanificacion  @relation(fields: [perfilPlanificacionId], references: [id], onDelete: Restrict)
  generacionIA             GeneracionIA?        @relation(fields: [generacionIAId], references: [id], onDelete: Restrict)
  entrenador               Personal?            @relation(fields: [entrenadorId], references: [id], onDelete: Restrict)
  aprobadoPor              User?                @relation("PlanAlimentacionAprobador", fields: [aprobadoPorId], references: [id], onDelete: SetNull)

  @@index([socioId])
  @@index([perfilPlanificacionId])
  @@index([generacionIAId])
  @@index([activo])
  @@index([estado])
}

model Ejercicio {
  id                      String   @id @default(uuid())
  nombre                  String   @unique
  descripcion             String?
  instrucciones           String?
  grupoMuscular           String   // PECHO, ESPALDA, PIERNAS, HOMBROS, BRAZOS, CORE, CUERPO_COMPLETO
  grupoMuscularSecundario String?
  nivel                   String   @default("PRINCIPIANTE") // PRINCIPIANTE, INTERMEDIO, AVANZADO
  tipoEjercicio           String   @default("FUERZA") // FUERZA, CARDIO, HIPERTROFIA, MOVILIDAD
  equipamientoRequerido   String   @default("GIMNASIO_COMPLETO") // GIMNASIO_COMPLETO, MANCUERNAS_BANCOS, PESO_CORPORAL, BANDAS_RESISTENCIA, OTRO
  restricciones           String?
  activo                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([grupoMuscular])
  @@index([nivel])
  @@index([equipamientoRequerido])
  @@index([activo])
}

// ============================================================================
// MÓDULO: ENTRENAMIENTO PERSONALIZADO Y HORARIOS (FASE H1)
// ============================================================================

model PeriodoEntrenamientoPersonalizado {
  id                    String                @id @default(uuid())
  socioId               String
  entrenadorId          String
  asignacionId          String?
  perfilPlanificacionId String?

  // Vigencia temporal del contrato/periodo
  fechaInicio           DateTime
  fechaFin              DateTime
  mesesPeriodo          Int                   @default(1)
  estado                String                @default("ACTIVO") // ACTIVO, FINALIZADO, PAUSADO, CANCELADO

  // Acuerdo de entrenamiento
  frecuenciaRecomendada Int                   // Recomendación técnica del entrenador (ej. 4 días/sem)
  frecuenciaAcordada    Int                   // Frecuencia pactada formalmente con el socio (ej. 2 días/sem)
  diasAcordados         Json                  // Días de la semana pactados: ["LUNES", "MIERCOLES"]
  horaInicioAcordada    String                // Hora de inicio base en America/Lima: "08:00"
  duracionMinutos       Int                   @default(60) // Duración de cada sesión (45, 60, 75, 90, 120)

  // Observaciones y Trazabilidad
  objetivoAcordado      String?
  observaciones         String?
  creadoPorUsuarioId    String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relaciones
  socio                 Socio                 @relation(fields: [socioId], references: [id], onDelete: Restrict)
  entrenador            Personal              @relation(fields: [entrenadorId], references: [id], onDelete: Restrict)
  asignacion            AsignacionEntrenador? @relation(fields: [asignacionId], references: [id], onDelete: Restrict)
  perfilPlanificacion   PerfilPlanificacion?  @relation(fields: [perfilPlanificacionId], references: [id], onDelete: Restrict)

  sesiones              SesionEntrenamientoPersonalizado[]

  @@index([socioId])
  @@index([entrenadorId])
  @@index([asignacionId])
  @@index([perfilPlanificacionId])
  @@index([estado])
  @@index([fechaInicio, fechaFin])
}

model SesionEntrenamientoPersonalizado {
  id                     String                             @id @default(uuid())
  periodoId              String
  socioId                String
  entrenadorId           String

  // Tiempos exactos y Fuente de Verdad
  fecha                  DateTime                           // Fecha del día (medianoche en Lima)
  horaInicio             String                             // "08:00" (representación formateada en Lima)
  horaFin                String                             // "09:00" (representación formateada en Lima)
  fechaHoraInicio        DateTime                           // Timestamp UTC exacto para ordenamiento y consultas
  fechaHoraFin           DateTime                           // Timestamp UTC exacto para detección de solapamientos
  duracionMinutos        Int                                @default(60)

  // Estado de la sesión
  estado                 String                             @default("PROGRAMADA") // PROGRAMADA, COMPLETADA, CANCELADA_CLIENTE, CANCELADA_ENTRENADOR, CANCELADA_GIMNASIO, NO_ASISTIO, REPROGRAMADA

  // Trazabilidad de Reprogramación
  esReprogramada         Boolean                            @default(false)
  sesionOriginalId       String?                            // Apunta a la sesión original previa si esta es nueva
  reprogramadaEnSesionId String?                            // Apunta a la sesión de destino si esta fue reprogramada
  motivoReprogramacion   String?

  // Cancelación y Notas
  motivoCancelacion      String?
  notasEntrenador        String?

  // Asistencia específica de sesión (Human Check-in para FASE H7)
  asistio                Boolean?
  horaCheckIn            DateTime?
  marcadoPorUsuarioId    String?

  // Auditoría
  creadoPorUsuarioId     String?
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt

  // Relaciones
  periodo                PeriodoEntrenamientoPersonalizado  @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  socio                  Socio                              @relation(fields: [socioId], references: [id], onDelete: Restrict)
  entrenador             Personal                           @relation(fields: [entrenadorId], references: [id], onDelete: Restrict)

  sesionOriginal         SesionEntrenamientoPersonalizado?  @relation("HistorialReprogramacion", fields: [sesionOriginalId], references: [id], onDelete: SetNull)
  sesionesDerivadas      SesionEntrenamientoPersonalizado[] @relation("HistorialReprogramacion")

  @@index([socioId, fechaHoraInicio])
  @@index([entrenadorId, fechaHoraInicio])
  @@index([periodoId])
  @@index([estado])
  @@index([fecha])
  @@index([fechaHoraInicio, fechaHoraFin])
}

